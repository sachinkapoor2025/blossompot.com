NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sample catalog indexing (default off). Set to 1 only on demo envs that intentionally want samples in Google/sitemaps.
# SAMPLE_PRODUCT_INDEXABLE=0
# Optional — leave unset. Do not use the retired +1 (669) 260-3819 number.
# NEXT_PUBLIC_SUPPORT_PHONE=
# Amplify branch overrides (set per branch in console — not in git):
#   main → NEXT_PUBLIC_SITE_URL=https://www.blossompot.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_DEV_AUTH=true
NEXT_PUBLIC_USD_INR_RATE=96
OPENAI_API_KEY=
# IndexNow (Bing/Yandex) — never commit the live key
# INDEXNOW_KEY=

# Google Business reviews (Places Details API) — section hidden until configured
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=ChIJ...
# NEXT_PUBLIC_GOOGLE_MAPS_URL=https://g.page/r/...
