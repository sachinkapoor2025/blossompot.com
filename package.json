{
  "name": "blossompot",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @blossompot/web",
    "dev:api": "npm run dev -w @blossompot/api",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:sample-products": "tsx scripts/seed-sample-products.ts",
    "seed:sample-products:dry": "tsx scripts/seed-sample-products.ts --dry-run --write-json",
    "validate:sample-products": "tsx scripts/validate-sample-products.ts",
    "geo:generate": "python3 scripts/geo/generate-geo-content.py",
    "geo:validate": "python3 scripts/geo/generate-geo-content.py --validate-only",
    "geo:enrich-nearby": "python3 scripts/geo/enrich-nearby-distance.py",
    "assert:no-meta-keywords": "tsx scripts/assert-no-meta-keywords.ts",
    "assert:geo-hygiene": "tsx scripts/assert-geo-hygiene.ts",
    "assert:international-geo": "tsx scripts/assert-international-geo.ts",
    "assert:session-a": "npm run assert:no-meta-keywords && npm run assert:geo-hygiene && npm run geo:validate && npm run assert:international-geo",
    "audit:seo": "tsx scripts/audit-seo.ts",
    "audit:seo-tech": "tsx scripts/audit-seo-tech.ts",
    "audit:crawlers": "tsx scripts/audit-crawlers.ts",
    "import:blossompot": "tsx scripts/import-blossompot.ts",
    "import:blossompot:fetch": "tsx scripts/import-blossompot.ts --fetch-only",
    "import:orange-county": "tsx scripts/import-orange-county.ts",
    "generate:orange-county-catalog": "tsx scripts/generate-orange-county-catalog.ts",
    "seed:inventory": "tsx scripts/seed-inventory.ts",
    "seed:serviceability": "tsx scripts/seed-serviceability.ts",
    "fix:seo-descriptions": "tsx scripts/fix-seo-descriptions.ts",
    "migrate:images": "tsx scripts/migrate-images-to-s3.ts",
    "rewrite:product-images": "tsx scripts/rewrite-product-image-urls.ts",
    "restore:product-images": "tsx scripts/restore-product-images-from-pitr.ts",
    "reconcile:s3-images": "tsx scripts/reconcile-s3-product-images.ts",
    "migrate:multitable": "tsx scripts/migrate-to-multitable.ts",
    "setup:local": "npm run db:up && sleep 3 && npm run db:setup && npm run seed",
    "build": "npm run build -w @blossompot/shared && npm run build -w @blossompot/api && npm run build -w @blossompot/web",
    "lint": "npm run lint -w @blossompot/web && npm run lint -w @blossompot/api",
    "typecheck": "npm run typecheck -w @blossompot/shared && npm run typecheck -w @blossompot/api && npm run typecheck -w @blossompot/web",
    "load:warmup": "k6 run scripts/load/warmup.js",
    "load:browse": "k6 run scripts/load/browse.js",
    "load:mixed": "k6 run scripts/load/mixed.js",
    "load:spike": "k6 run scripts/load/spike.js",
    "load:ssr": "k6 run scripts/load/ssr.js",
    "load:local": "node scripts/load/run-local.mjs",
    "load:smoke": "bash scripts/load/smoke.sh",
    "test": "npm run test -w @blossompot/shared"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22"
  }
}
